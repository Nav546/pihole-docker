# Copy this file to .env and set your own values.
# .env is git-ignored so your real password never reaches GitHub.
TZ=Australia/Melbourne
PIHOLE_PASSWORD=change-me-to-something-strong

# Private Docker network for Pi-hole and Unbound
DNS_SUBNET=172.20.0.0/24
UNBOUND_IP=172.20.0.2
PIHOLE_IP=172.20.0.3
